# ============================================================================
# BASMA (@basma.llb) — Production Environment Variables Template
# Copy this file to .env or configure directly in your Vercel Project Settings.
# Never commit actual .env or .env.local files to GitHub or version control.
# ============================================================================

# --- Core Site & Studio Identity ---
VITE_SITE_URL=https://basma-llb-studio.vercel.app
VITE_WHATSAPP_NUMBER=96170360671
VITE_STUDIO_EMAIL=concierge@basma-studio.com

# --- Admin Authentication & Security ---
# SHA-256 hash of the Admin Access PIN (Default PIN: 2026)
ADMIN_SECRET_HASH=158a323a7ba44870f23d96f1516dd70aa48e9a72db4ebb026b0a89e212a208ab
VITE_ADMIN_PIN_HASH=158a323a7ba44870f23d96f1516dd70aa48e9a72db4ebb026b0a89e212a208ab

# Optional custom secret for signing admin session cookies
ADMIN_SESSION_SECRET=

# --- Primary Cloud Database Persistence (Vercel KV / Upstash Redis) ---
# When these are set, store state and order inquiries persist across all serverless function lifecycles.
# If left blank, the application uses zero-failure local JSON seed & memory fallback.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Persistent Photo & Asset Storage (Vercel Blob) ---
# Used by /api/upload to store customer and admin photos.
# If left blank, uploads fall back to optimized WebP base64 data URLs.
BLOB_READ_WRITE_TOKEN=
