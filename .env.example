# ============================================================================
# BASMA (@basma.llb) — Production Environment Configuration Example
# Copy this file to .env and fill in your optional cloud persistence credentials.
# Never commit .env to version control.
# ============================================================================

# Public Canonical Domain (used for SEO canonical links, OpenGraph, and JSON-LD)
VITE_SITE_URL=https://basma-studio.vercel.app

# WhatsApp Business Concierge Number (International format without '+')
VITE_WHATSAPP_NUMBER=96170360671

# Studio Contact Email
VITE_STUDIO_EMAIL=concierge@basma-studio.com

# Default Admin PIN SHA-256 Hash (Default PIN '2026' -> a688c2c38f05246f763409b4520c0aa3ecc3ba304c92af58665f5c636120296d)
VITE_ADMIN_PIN_HASH=a688c2c38f05246f763409b4520c0aa3ecc3ba304c92af58665f5c636120296d

# Optional Serverless Cloud Persistence (Vercel KV / Upstash Redis / JSONBin)
KV_REST_API_URL=
KV_REST_API_TOKEN=
CLOUD_SYNC_SECRET_TOKEN=
