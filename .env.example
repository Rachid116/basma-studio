# --- Free Permanent Database (Supabase Cloud Sync) ---
# Create a free project at https://supabase.com.
# Run this SQL in your Supabase SQL Editor:
#
#   create table if not exists site_data (
#     id text primary key,
#     content jsonb not null default '{}'::jsonb,
#     updated_at timestamp with time zone default timezone('utc'::text, now()) not null
#   );
#   alter table site_data enable row level security;
#   create policy "Allow public read access" on site_data for select using (true);
#   create policy "Allow anon insert and update" on site_data for all using (true) with check (true);
#
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

